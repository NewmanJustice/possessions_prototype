{% extends "layouts/main.njk" %}

{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {{ govukPanel({
      titleText: "Claim submitted",
      html: "Your reference number<br><strong>" + claim.reference + "</strong>"
    }) }}

    <p class="govuk-body">
      We have sent you a confirmation email.
    </p>

    <h2 class="govuk-heading-m">What happens next</h2>

    <p class="govuk-body">
      Your claim will be reviewed by court staff. You'll be notified about the next steps by email.
    </p>

    <p class="govuk-body">
      The court will:
    </p>

    <ul class="govuk-list govuk-list--bullet">
      <li>check your claim details</li>
      <li>issue the claim to the defendant</li>
      <li>set a hearing date if required</li>
    </ul>

    <h2 class="govuk-heading-m">If you need to contact us</h2>

    <p class="govuk-body">
      Use your reference number when contacting us about this claim: <strong>{{ claim.reference }}</strong>
    </p>

    <p class="govuk-body">
      <strong>Telephone:</strong> 0300 123 7050<br>
      <strong>Hours:</strong> Monday to Friday, 8:30am to 5pm
    </p>

    <p class="govuk-body govuk-!-margin-top-7">
      <a href="/possessions" class="govuk-link">Return to service home</a>
    </p>

    <div class="govuk-!-margin-top-9">
      <h3 class="govuk-heading-s">Prototype note</h3>
      <p class="govuk-body govuk-!-font-size-16">
        This is a prototype. No real claim has been submitted. Your data is stored in your browser session only and will be cleared when you sign out.
      </p>
    </div>

  </div>
</div>
{% endblock %}
