{% extends "layouts/main.njk" %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errors and errors.length > 0 %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: errors
      }) }}
    {% endif %}

    <form method="post" action="/claims/claim-type" novalidate>

      {{ govukRadios({
        name: "claimType",
        fieldset: {
          legend: {
            text: "What type of claim do you want to make?",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--l"
          }
        },
        items: [
          {
            value: "standard-possession-england",
            text: "Standard possession claim (England)",
            hint: {
              text: "For residential properties in England where you're seeking possession"
            },
            checked: values.claimType === "standard-possession-england"
          }
        ],
        errorMessage: { text: errors | selectattr('field', 'equalto', 'claimType') | map(attribute='message') | first } if errors and errors | selectattr('field', 'equalto', 'claimType') | list | length > 0
      }) }}

      {{ govukButton({
        text: "Continue"
      }) }}

    </form>

  </div>
</div>
{% endblock %}
