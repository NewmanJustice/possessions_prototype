{% extends "layouts/main.njk" %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errors and errors.length > 0 %}
      {{ govukErrorSummary({
        titleText: "Mae problem wedi codi",
        errorList: errors
      }) }}
    {% endif %}

    <span class="govuk-caption-l">Gwneud hawliad</span>
    <h1 class="govuk-heading-l">Manylion hawlydd (Cymru)</h1>

    {% set registeredError = null %}
    {% for error in errors %}
      {% if error.field == 'registered' %}
        {% set registeredError = error %}
      {% endif %}
    {% endfor %}

    {% set licensedError = null %}
    {% for error in errors %}
      {% if error.field == 'licensed' %}
        {% set licensedError = error %}
      {% endif %}
    {% endfor %}

    {% set agentError = null %}
    {% for error in errors %}
      {% if error.field == 'agent' %}
        {% set agentError = error %}
      {% endif %}
    {% endfor %}

    <form method="post" action="/claims/welsh-claimant-details" novalidate>
      {% set checkedYes = values.registered == "yes" %}
      {% set checkedNo = values.registered == "no" %}
      {% set checkedNA = values.registered == "not-applicable" %}
      {{ govukRadios({
        name: "registered",
        fieldset: {
          legend: {
            text: "A ydych wedi’ch cofrestru o dan Ran 1 o Ddeddf Tai (Cymru) 2014?",
            classes: "govuk-fieldset__legend--m"
          }
        },
        items: [
          { value: "yes", text: "Ie", checked: checkedYes },
          { value: "no", text: "Na", checked: checkedNo },
          { value: "not-applicable", text: "Ddim yn berthnasol", checked: checkedNA }
        ],
        errorMessage: { text: registeredError.message } if registeredError
      }) }}

      {% set checkedYesLic = values.licensed == "yes" %}
      {% set checkedNoLic = values.licensed == "no" %}
      {% set checkedNALic = values.licensed == "not-applicable" %}
      {{ govukRadios({
        name: "licensed",
        fieldset: {
          legend: {
            text: "A ydych wedi’ch trwyddedu o dan Ran 1 o Ddeddf Tai (Cymru) 2014?",
            classes: "govuk-fieldset__legend--m"
          }
        },
        items: [
          { value: "yes", text: "Ie", checked: checkedYesLic },
          { value: "no", text: "Na", checked: checkedNoLic },
          { value: "not-applicable", text: "Ddim yn berthnasol", checked: checkedNALic }
        ],
        errorMessage: { text: licensedError.message } if licensedError
      }) }}

      {% set checkedYesAgent = values.agent == "yes" %}
      {% set checkedNoAgent = values.agent == "no" %}
      {% set checkedNAAgent = values.agent == "not-applicable" %}
      {{ govukRadios({
        name: "agent",
        fieldset: {
          legend: {
            text: "A ydych wedi penodi asiant trwyddedig ar gyfer rheoli’r eiddo?",
            classes: "govuk-fieldset__legend--m"
          }
        },
        items: [
          { value: "yes", text: "Ie", checked: checkedYesAgent },
          { value: "no", text: "Na", checked: checkedNoAgent },
          { value: "not-applicable", text: "Ddim yn berthnasol", checked: checkedNAAgent }
        ],
        errorMessage: { text: agentError.message } if agentError
      }) }}

      <div class="govuk-button-group">
        {{ govukButton({
          text: "Yn ôl",
          classes: "govuk-button--secondary",
          href: "/claims/claim-type"
        }) }}

        {{ govukButton({
          text: "Bwrw ymlaen"
        }) }}
      </div>
    </form>

    <p class="govuk-body">
      <a href="/case-list" class="govuk-link">Canslo</a>
    </p>
    <p class="govuk-body">
      <a href="#" class="govuk-link">Rwyf eisiau cadw’r cais hwn a dychwelyd ato yn nes ymlaen</a>
    </p>
  </div>
</div>
{% endblock %}
