{% extends "layouts/main.njk" %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errorList.length > 0 %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: errorList,
        attributes: {
          tabindex: "-1"
        }
      }) }}
    {% endif %}

    <span class="govuk-caption-l">Make a claim</span>
    <h1 class="govuk-heading-l">Mediation and settlement</h1>

    <form method="post" action="/claims/mediation-settlement" novalidate>

      {# Mediation Section #}
      <h2 class="govuk-heading-m">Mediation</h2>

      <p class="govuk-body">
        Mediation is a way of resolving disputes without going to court. A neutral third party helps both sides reach an agreement.
      </p>

      {{ govukRadios({
        name: "mediationAttempted",
        fieldset: {
          legend: {
            text: "Have you attempted mediation with the defendants?",
            classes: "govuk-fieldset__legend--m"
          }
        },
        items: [
          {
            value: "true",
            text: "Yes",
            checked: values.mediationAttempted == "true",
            conditional: {
              html: govukTextarea({
                name: "mediationDetails",
                id: "mediationDetails",
                label: {
                  text: "Give details about the attempted mediation and what the outcome was"
                },
                hint: {
                  text: "You can enter up to 250 characters"
                },
                value: values.mediationDetails,
                errorMessage: {
                  text: fieldErrors.mediationDetails
                } if fieldErrors.mediationDetails
              })
            }
          },
          {
            value: "false",
            text: "No",
            checked: values.mediationAttempted == "false"
          }
        ],
        errorMessage: {
          text: fieldErrors.mediationAttempted
        } if fieldErrors.mediationAttempted
      }) }}

      {# Settlement Section #}
      <h2 class="govuk-heading-m">Settlement</h2>

      <p class="govuk-body">
        Before making a claim, you should try to reach a settlement with the defendants. This could include agreeing a payment plan or other arrangements.
      </p>

      {{ govukRadios({
        name: "settlementAttempted",
        fieldset: {
          legend: {
            text: "Have you tried to reach a settlement with the defendants?",
            classes: "govuk-fieldset__legend--m"
          }
        },
        items: [
          {
            value: "true",
            text: "Yes",
            checked: values.settlementAttempted == "true",
            conditional: {
              html: govukTextarea({
                name: "settlementDetails",
                id: "settlementDetails",
                label: {
                  text: "Explain what steps you've taken to reach a settlement"
                },
                hint: {
                  text: "You can enter up to 250 characters"
                },
                value: values.settlementDetails,
                errorMessage: {
                  text: fieldErrors.settlementDetails
                } if fieldErrors.settlementDetails
              })
            }
          },
          {
            value: "false",
            text: "No",
            checked: values.settlementAttempted == "false"
          }
        ],
        errorMessage: {
          text: fieldErrors.settlementAttempted
        } if fieldErrors.settlementAttempted
      }) }}

      <div class="govuk-button-group">
        {{ govukButton({
          text: "Previous",
          classes: "govuk-button--secondary",
          href: "/claims/preaction-protocol"
        }) }}

        {{ govukButton({
          text: "Continue"
        }) }}
      </div>

    </form>

    <p class="govuk-body">
      <a href="/case-list" class="govuk-link">Cancel</a>
    </p>

  </div>
</div>
{% endblock %}
