{% extends "layouts/main.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle -%}
  Check your answers - {{ serviceName }} - GOV.UK
{%- endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-l">Check your answers</h1>

    <p class="govuk-body">Case number: <strong>{{ caseNumber or '1234-5678-9101-1213' }}</strong></p>

    {{ govukSummaryList({
      rows: [
        {
          key: { text: "What is the address of the property you're claiming possession of?" },
          value: { html: "10 Garden Drive<br>Luton<br>Bedfordshire<br>LU1 1AB" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "property address"
            }]
          }
        },
        {
          key: { text: "Who is the claimant in this case?" },
          value: { text: "A neighbourhood social housing" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "claimant"
            }]
          }
        },
        {
          key: { text: "Who are you making a possession claim against?" },
          value: { text: "Tenant" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "who you are claiming against"
            }]
          }
        },
        {
          key: { text: "Is this the correct claimant name?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "correct claimant name"
            }]
          }
        },
        {
          key: { text: "Do you want to use this email address for notifications?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "email address for notifications"
            }]
          }
        },
        {
          key: { text: "Do you want documents to be sent to this address?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "documents address"
            }]
          }
        },
        {
          key: { text: "Do you want to provide a contact phone number?" },
          value: { text: "No" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "contact phone number"
            }]
          }
        },
        {
          key: { text: "Do you know the defendant's name?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "defendant name known"
            }]
          }
        },
        {
          key: { text: "Defendant's first name" },
          value: { text: "Billy" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "defendant's first name"
            }]
          }
        },
        {
          key: { text: "Is the defendant's correspondence address the same as the address of the property you're claiming possession of?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "defendant correspondence address"
            }]
          }
        },
        {
          key: { text: "What type of tenancy or licence is in place?" },
          value: { text: "Secure tenancy" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "tenancy type"
            }]
          }
        },
        {
          key: { text: "What date did the tenancy or licence start?" },
          value: { text: "04/03/2015" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "tenancy start date"
            }]
          }
        },
        {
          key: { text: "Do you want to upload a copy of the tenancy or licence agreement? (Optional)" },
          value: { text: "No" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "tenancy agreement upload"
            }]
          }
