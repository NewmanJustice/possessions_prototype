            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "rent statement"
            }]
          }
        },
        {
          key: { text: "How much are the total rent arrears as shown on the rent statement?" },
          value: { text: "3,000" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "total rent arrears"
            }]
          }
        },
        {
          key: { text: "For the period shown on the rent statement, have any rent payments been paid by someone other than the defendant/s?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "third party payments"
            }]
          }
