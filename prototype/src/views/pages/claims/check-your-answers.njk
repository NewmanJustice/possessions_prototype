        {
          key: { text: "Where have the payments come from?" },
          value: { text: "Housing benefit" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "payment source"
            }]
          }
        },
        {
          key: { text: "Do you want the court to make a judgment for the outstanding arrears?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "money judgement"
            }]
          }
        },
        {
          key: { text: "Is there an underlessee or mortgagee entitled to claim relief to a forfeiture against the defendant?" },
          value: { text: "No" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "underlessee or mortgagee"
            }]
          }
        },
        {
          key: { text: "Is there any information you'd like to provide about Tenancy Housing's Resilience?" },
          value: { text: "No" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "tenancy housing resilience"
            }]
          }
        },
        {
          key: { text: "Is there any information you'd like to provide about your reasons for possession?" },
          value: { text: "No" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "reasons for possession"
            }]
          }
        },
        {
          key: { text: "Do you want to ask for your costs back?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "claiming costs"
            }]
          }
        },
        {
          key: { text: "Is there any other information you'd like to provide about your reasons for possession?" },
          value: { text: "No" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "additional reasons for possession"
            }]
          }
        },
        {
          key: { text: "Do you want to upload any additional documents?" },
          value: { text: "No" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "additional documents"
            }]
          }
        },
        {
          key: { text: "Are you claiming to expedite a warrant and/or seizure of the same time as your claim?" },
          value: { text: "No" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "expedite warrant"
            }]
          }
        },
        {
          key: { text: "Statement of truth completed by" },
          value: { text: "Claimant" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "statement of truth"
            }]
          }
        }
      ]
    }) }}

    <form method="post" action="/claims/check-your-answers" novalidate>
      <div class="govuk-button-group">
        {{ govukButton({
          text: "Previous",
          name: "action",
          value: "previous",
          classes: "govuk-button--secondary"
        }) }}

        {{ govukButton({
          text: "Submit and pay"
        }) }}
      </div>

      <p class="govuk-body">
        <a href="/case-list" class="govuk-link">Cancel</a>
      </p>
    </form>

  </div>
</div>
{% endblock %}
