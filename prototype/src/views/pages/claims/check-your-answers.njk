            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "grounds for possession"
            }]
          }
        },
        {
          key: { text: "Do you have any other grounds for possession?" },
          value: { text: "No" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "other grounds for possession"
            }]
          }
        },
        {
          key: { text: "Have you followed the pre-action protocol?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "pre-action protocol"
            }]
          }
        },
        {
          key: { text: "Have you attempted mediation with the defendant?" },
          value: { text: "No" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "mediation attempted"
            }]
          }
        },
        {
          key: { text: "Have you tried to reach a settlement with the defendant/s?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "settlement attempted"
            }]
          }
        },
        {
          key: { text: "Have you served notice to the defendant/s?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "notice served"
            }]
          }
        },
        {
          key: { text: "How did you serve the notice?" },
          value: { text: "First class post" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "notice service method"
            }]
          }
        },
        {
          key: { text: "Date the document was posted" },
          value: { text: "01/01/2024" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "document posted date"
            }]
          }
        },
        {
          key: { text: "Do you want to upload documents relating to the notice you served or the certificate of service? (Optional)" },
          value: { text: "No" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "notice documents upload"
            }]
          }
        },
        {
          key: { text: "How much is the rent?" },
          value: { text: "625" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "rent amount"
            }]
          }
        },
        {
          key: { text: "How frequently should rent be paid?" },
          value: { text: "Weekly" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "rent frequency"
            }]
          }
        },
        {
          key: { text: "Is the amount per day that unpaid rent should be charged at correct?" },
          value: { text: "Yes" },
          actions: {
            items: [{
              href: "#",
              text: "Change",
              visuallyHiddenText: "daily rent amount"
            }]
