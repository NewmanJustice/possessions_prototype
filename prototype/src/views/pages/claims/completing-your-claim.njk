{% extends "layouts/main.njk" %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle -%}
  {% if errorList and errorList.length > 0 %}Error: {% endif %}Completing your claim - {{ serviceName }} - GOV.UK
{%- endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errorList and errorList.length > 0 %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: errorList,
        attributes: {
          tabindex: "-1"
        }
      }) }}
    {% endif %}

    <span class="govuk-caption-l">Make a claim</span>
    <h1 class="govuk-heading-l">Completing your claim</h1>

    <p class="govuk-body">Case number: <strong>{{ caseNumber or '1234-5678-9101-1213' }}</strong></p>

    <p class="govuk-body">There are two options for what do to next:</p>

    <ul class="govuk-list govuk-list--bullet">
      <li>sign the statement of truth, check your answers, then submit and pay for your claim now.</li>
      <li>check your answers and save your claim as a draft. You can return later to sign the statement of truth and submit and pay.</li>
    </ul>

    <form method="post" action="/claims/completing-your-claim" novalidate>

      {{ govukRadios({
        name: "completionPreference",
        idPrefix: "completionPreference",
        fieldset: {
          legend: {
            text: "What would you like to do next?",
            classes: "govuk-fieldset__legend--m"
          }
        },
        errorMessage: errors.completionPreference if errors.completionPreference,
        items: [
          {
            value: "submit-now",
            text: "Submit and pay for my claim now",
            checked: completionPreference == 'submit-now'
          },
          {
            value: "save-for-later",
            text: "Save it for later",
            checked: completionPreference == 'save-for-later'
          }
        ]
      }) }}

      <div class="govuk-button-group">
        {{ govukButton({
          text: "Previous",
          name: "action",
          value: "previous",
          classes: "govuk-button--secondary"
        }) }}

        {{ govukButton({
          text: "Continue",
          name: "action",
          value: "continue"
        }) }}
      </div>

      <p class="govuk-body">
        <a href="/case-list" class="govuk-link">Cancel</a>
      </p>

    </form>

  </div>
</div>
{% endblock %}
