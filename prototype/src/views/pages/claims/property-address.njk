{% extends "layouts/main.njk" %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errors and errors.length > 0 %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: errors
      }) }}
    {% endif %}

    <h1 class="govuk-heading-l">What is the property address?</h1>

    {{ govukInsetText({
      text: "Address lookup will be added in a later iteration. For now, enter the address manually."
    }) }}

    {% set addressLine1Error = null %}
    {% set townError = null %}
    {% set postcodeError = null %}
    {% for error in errors %}
      {% if error.field == 'addressLine1' %}
        {% set addressLine1Error = error %}
      {% elif error.field == 'town' %}
        {% set townError = error %}
      {% elif error.field == 'postcode' %}
        {% set postcodeError = error %}
      {% endif %}
    {% endfor %}

    <form method="post" action="/claims/property-address" novalidate>

      {{ govukInput({
        label: {
          text: "Address line 1"
        },
        id: "addressLine1",
        name: "addressLine1",
        autocomplete: "address-line1",
        value: values.addressLine1,
        errorMessage: { text: addressLine1Error.message } if addressLine1Error
      }) }}

      {{ govukInput({
        label: {
          text: "Address line 2 (optional)"
        },
        id: "addressLine2",
        name: "addressLine2",
        autocomplete: "address-line2",
        value: values.addressLine2
      }) }}

      {{ govukInput({
        label: {
          text: "Town or city"
        },
        id: "town",
        name: "town",
        autocomplete: "address-level2",
        classes: "govuk-!-width-two-thirds",
        value: values.town,
        errorMessage: { text: townError.message } if townError
      }) }}

      {{ govukInput({
        label: {
          text: "County (optional)"
        },
        id: "county",
        name: "county",
        classes: "govuk-!-width-two-thirds",
        value: values.county
      }) }}

      {{ govukInput({
        label: {
          text: "Postcode"
        },
        id: "postcode",
        name: "postcode",
        autocomplete: "postal-code",
        classes: "govuk-input--width-10",
        value: values.postcode,
        errorMessage: { text: postcodeError.message } if postcodeError
      }) }}

      {{ govukButton({
        text: "Continue"
      }) }}

    </form>

  </div>
</div>
{% endblock %}
