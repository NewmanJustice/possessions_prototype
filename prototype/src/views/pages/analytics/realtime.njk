{% extends "layouts/analytics.njk" %}

{% set activePage = 'realtime' %}

{% block content %}
<div class="page-header">
  <h1 class="page-title">Real-time</h1>
  <p class="page-subtitle">Live user activity feed</p>
</div>

<div class="realtime-indicator">
  <span class="dot"></span>
  <span>Auto-refreshing every 10 seconds</span>
</div>

{% if events and events.length > 0 %}
<div class="card">
  <table class="table">
    <thead>
      <tr>
        <th style="width: 140px;">Time</th>
        <th style="width: 100px;">Session</th>
        <th style="width: 110px;">Type</th>
        <th>Page / Action</th>
        <th style="width: 150px;">Details</th>
      </tr>
    </thead>
    <tbody>
      {% for event in events %}
      <tr>
        <td>{{ event.createdAt }}</td>
        <td><span class="session-id">{{ event.sessionId }}</span></td>
        <td>
          {% if event.eventType == 'page_view' %}
            <span class="badge badge-blue">page view</span>
          {% elif event.eventType == 'form_submit' %}
            {% if event.eventName == 'valid' %}
              <span class="badge badge-green">form valid</span>
            {% else %}
              <span class="badge badge-red">form invalid</span>
            {% endif %}
          {% elif event.eventType == 'navigation' %}
            <span class="badge badge-gray">{{ event.eventName }}</span>
          {% elif event.eventType == 'journey_complete' %}
            <span class="badge badge-green">complete</span>
          {% else %}
            <span class="badge badge-gray">{{ event.eventType }}</span>
          {% endif %}
        </td>
        <td>
          {% if event.pageUrl %}
            <a href="{{ event.pageUrl }}">{{ event.pageUrl }}</a>
          {% else %}
            {{ event.eventName }}
          {% endif %}
        </td>
        <td style="font-size: 12px; color: var(--color-gray-500);">
          {% if event.metadata.errors and event.metadata.errors.length > 0 %}
            {{ event.metadata.errors | join(', ') }}
          {% elif event.metadata.destination %}
            → {{ event.metadata.destination }}
          {% else %}
            -
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<div class="card">
  <div class="card-body">
    <div class="empty-state">
      No events recorded yet. Start using the prototype to generate data.
    </div>
  </div>
</div>
{% endif %}

<script>
  // Auto-refresh every 10 seconds
  setTimeout(function() {
    location.reload();
  }, 10000);
</script>
{% endblock %}
