{% extends "layouts/main.njk" %}

{% block pageTitle %}Real-time - {{ serviceName }}{% endblock %}

{% block head %}
{{ super() }}
<style>
  .analytics-layout {
    display: flex;
    min-height: calc(100vh - 200px);
    margin: -30px -15px;
  }
  .analytics-sidebar {
    width: 220px;
    background: #f3f2f1;
    border-right: 1px solid #b1b4b6;
    padding: 20px 0;
    flex-shrink: 0;
  }
  .analytics-sidebar a {
    display: block;
    padding: 10px 20px;
    color: #0b0c0c;
    text-decoration: none;
    font-size: 16px;
    border-left: 4px solid transparent;
  }
  .analytics-sidebar a:hover {
    background: #e8e8e8;
  }
  .analytics-sidebar a.active {
    background: #fff;
    border-left-color: #1d70b8;
    font-weight: bold;
  }
  .analytics-sidebar .nav-section {
    padding: 15px 20px 5px;
    font-size: 12px;
    text-transform: uppercase;
    color: #505a5f;
    font-weight: bold;
  }
  .analytics-content {
    flex: 1;
    padding: 30px;
    background: #fff;
  }
  .realtime-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: #f3f2f1;
    border-radius: 4px;
    font-size: 14px;
    margin-bottom: 20px;
  }
  .realtime-indicator .dot {
    width: 10px;
    height: 10px;
    background: #00703c;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .event-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .event-table th, .event-table td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid #b1b4b6;
  }
  .event-table th {
    font-weight: bold;
    background: #f3f2f1;
    font-size: 12px;
    text-transform: uppercase;
  }
  .event-table tr:hover {
    background: #f8f8f8;
  }
  .event-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
  }
  .event-tag.page-view { background: #d2e2f1; color: #144e81; }
  .event-tag.form-valid { background: #cce2d8; color: #00703c; }
  .event-tag.form-invalid { background: #f6d7d2; color: #d4351c; }
  .event-tag.navigation { background: #e8e8e8; color: #505a5f; }
  .event-tag.complete { background: #cce2d8; color: #00703c; }
  .session-id {
    font-family: monospace;
    font-size: 11px;
    color: #505a5f;
  }
</style>
{% endblock %}

{% block content %}
<div class="analytics-layout">
  <nav class="analytics-sidebar">
    <div class="nav-section">Reports</div>
    <a href="{{ basePath }}">Overview</a>
    <a href="{{ basePath }}/realtime" class="active">Real-time</a>
    <div class="nav-section">Engagement</div>
    <a href="{{ basePath }}/pages">Pages</a>
    <a href="{{ basePath }}/behaviour">Behaviour</a>
    <div class="nav-section">Tools</div>
    <a href="/__prototype-annotator/dashboard">Annotations</a>
    <a href="/case-list">← Back to prototype</a>
  </nav>

  <main class="analytics-content">
    <h1 class="govuk-heading-xl" style="margin-bottom: 10px;">Real-time</h1>
    <p class="govuk-body" style="color: #505a5f; margin-bottom: 20px;">Live user activity feed</p>

    <div class="realtime-indicator">
      <span class="dot"></span>
      <span>Auto-refreshing every 10 seconds</span>
    </div>

    {% if events and events.length > 0 %}
    <table class="event-table">
      <thead>
        <tr>
          <th style="width: 130px;">Time</th>
          <th style="width: 90px;">Session</th>
          <th style="width: 100px;">Type</th>
          <th>Page / Action</th>
          <th style="width: 150px;">Details</th>
        </tr>
      </thead>
      <tbody>
        {% for event in events %}
        <tr>
          <td>{{ event.createdAt }}</td>
          <td><span class="session-id">{{ event.sessionId | truncate(8, true, '') }}</span></td>
          <td>
            {% if event.eventType == 'page_view' %}
              <span class="event-tag page-view">page view</span>
            {% elif event.eventType == 'form_submit' %}
              {% if event.eventName == 'valid' %}
                <span class="event-tag form-valid">form valid</span>
              {% else %}
                <span class="event-tag form-invalid">form invalid</span>
              {% endif %}
            {% elif event.eventType == 'navigation' %}
              <span class="event-tag navigation">{{ event.eventName }}</span>
            {% elif event.eventType == 'journey_complete' %}
              <span class="event-tag complete">complete</span>
            {% else %}
              <span class="event-tag">{{ event.eventType }}</span>
            {% endif %}
          </td>
          <td>
            {% if event.pageUrl %}
              <a href="{{ event.pageUrl }}" class="govuk-link" style="font-size: 13px;">{{ event.pageUrl }}</a>
            {% else %}
              {{ event.eventName }}
            {% endif %}
          </td>
          <td style="font-size: 12px; color: #505a5f;">
            {% if event.metadata.errors and event.metadata.errors.length > 0 %}
              {{ event.metadata.errors | join(', ') }}
            {% elif event.metadata.destination %}
              → {{ event.metadata.destination }}
            {% else %}
              -
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="govuk-inset-text">
      No events recorded yet. Start using the prototype to generate data.
    </div>
    {% endif %}
  </main>
</div>

<script>
  // Auto-refresh every 10 seconds
  setTimeout(function() {
    location.reload();
  }, 10000);
</script>
{% endblock %}
