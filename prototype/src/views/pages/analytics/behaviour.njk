{% extends "layouts/analytics.njk" %}

{% set activePage = 'behaviour' %}

{% block content %}
<div class="page-header">
  <h1 class="page-title">User Behaviour</h1>
  <p class="page-subtitle">Navigation patterns and validation errors</p>
</div>

<div class="time-filter">
  <a href="?days=1" {% if days == 1 %}class="active"{% endif %}>Today</a>
  <a href="?days=7" {% if days == 7 %}class="active"{% endif %}>Last 7 days</a>
  <a href="?days=30" {% if days == 30 %}class="active"{% endif %}>Last 30 days</a>
  <a href="?days=90" {% if days == 90 %}class="active"{% endif %}>Last 90 days</a>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Navigation Actions</h3>
    </div>
    <div class="card-body">
      {% if navigation %}
        {% set totalNav = (navigation.continue or 0) + (navigation.previous or 0) + (navigation.cancel or 0) %}
        {% if totalNav > 0 %}
        <div class="stats-grid" style="margin-bottom: 20px;">
          <div class="stat-card">
            <div class="stat-label">Continue</div>
            <div class="stat-value" style="color: var(--color-success);">{{ navigation.continue or 0 }}</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Previous</div>
            <div class="stat-value" style="color: var(--color-warning);">{{ navigation.previous or 0 }}</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Cancel</div>
            <div class="stat-value" style="color: var(--color-danger);">{{ navigation.cancel or 0 }}</div>
          </div>
        </div>

        <div class="chart-bar">
          <div class="label">Continue</div>
          <div class="bar-container">
            <div class="bar" style="width: {{ ((navigation.continue or 0) / totalNav * 100) }}%; background: var(--color-success);"></div>
          </div>
          <div class="count">{{ ((navigation.continue or 0) / totalNav * 100) | round }}%</div>
        </div>
        <div class="chart-bar">
          <div class="label">Previous</div>
          <div class="bar-container">
            <div class="bar" style="width: {{ ((navigation.previous or 0) / totalNav * 100) }}%; background: var(--color-warning);"></div>
          </div>
          <div class="count">{{ ((navigation.previous or 0) / totalNav * 100) | round }}%</div>
        </div>
        <div class="chart-bar">
          <div class="label">Cancel</div>
          <div class="bar-container">
            <div class="bar" style="width: {{ ((navigation.cancel or 0) / totalNav * 100) }}%; background: var(--color-danger);"></div>
          </div>
          <div class="count">{{ ((navigation.cancel or 0) / totalNav * 100) | round }}%</div>
        </div>
        {% else %}
          <div class="empty-state">No navigation data yet</div>
        {% endif %}
      {% else %}
        <div class="empty-state">No navigation data yet</div>
      {% endif %}
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Drop-off Points</h3>
    </div>
    <div class="card-body">
      {% if dropOffs and dropOffs.length > 0 %}
        {% set maxDropOffs = dropOffs[0].count %}
        {% for drop in dropOffs.slice(0, 5) %}
        <div class="chart-bar">
          <div class="label" title="{{ drop.url }}">{{ drop.url }}</div>
          <div class="bar-container">
            <div class="bar" style="width: {{ (drop.count / maxDropOffs * 100) }}%; background: var(--color-danger);"></div>
          </div>
          <div class="count">{{ drop.count }}</div>
        </div>
        {% endfor %}
      {% else %}
        <div class="empty-state">No drop-off data yet</div>
      {% endif %}
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-title">Validation Errors</h3>
  </div>
  <div class="card-body">
    <p style="color: var(--color-gray-500); font-size: 13px; margin-bottom: 16px;">
      Fields that users most frequently get wrong
    </p>
    {% if validationErrors and validationErrors.length > 0 %}
    <table class="table">
      <thead>
        <tr>
          <th>Page</th>
          <th>Field</th>
          <th style="text-align: right;">Error Count</th>
        </tr>
      </thead>
      <tbody>
        {% for error in validationErrors %}
        <tr>
          <td><a href="{{ error.url }}">{{ error.url }}</a></td>
          <td><span class="badge badge-red">{{ error.field }}</span></td>
          <td style="text-align: right; font-weight: 600;">{{ error.count }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
      <div class="empty-state">
        No validation errors recorded yet. This is good - users are finding it easy to complete forms correctly.
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
