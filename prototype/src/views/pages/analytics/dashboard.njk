{% extends "layouts/analytics.njk" %}

{% set activePage = 'overview' %}

{% block content %}
<div class="page-header">
  <h1 class="page-title">Analytics Overview</h1>
  <p class="page-subtitle">Prototype usage statistics</p>
</div>

<div class="time-filter">
  <a href="?days=1" {% if days == 1 %}class="active"{% endif %}>Today</a>
  <a href="?days=7" {% if days == 7 %}class="active"{% endif %}>Last 7 days</a>
  <a href="?days=30" {% if days == 30 %}class="active"{% endif %}>Last 30 days</a>
  <a href="?days=90" {% if days == 90 %}class="active"{% endif %}>Last 90 days</a>
</div>

{% if stats %}
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Users</div>
    <div class="stat-value">{{ stats.totalSessions }}</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Page Views</div>
    <div class="stat-value">{{ stats.totalPageViews }}</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Form Submissions</div>
    <div class="stat-value">{{ stats.totalFormSubmits }}</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Validation Pass Rate</div>
    <div class="stat-value">{{ stats.validationRate }}%</div>
    <div class="stat-change {% if stats.validationRate >= 80 %}positive{% elif stats.validationRate < 50 %}negative{% endif %}">
      {{ stats.validSubmits }} valid / {{ stats.invalidSubmits }} invalid
    </div>
  </div>
</div>

{% if dailyActivity and dailyActivity.length > 0 %}
<div class="card">
  <div class="card-header">
    <h3 class="card-title">Daily Activity</h3>
  </div>
  <table class="table">
    <thead>
      <tr>
        <th>Date</th>
        <th style="text-align: right;">Sessions</th>
        <th style="text-align: right;">Page Views</th>
        <th style="text-align: right;">Form Submits</th>
      </tr>
    </thead>
    <tbody>
      {% for day in dailyActivity %}
      <tr>
        <td>{{ day.date }}</td>
        <td style="text-align: right;">{{ day.sessions }}</td>
        <td style="text-align: right;">{{ day.pageViews }}</td>
        <td style="text-align: right;">{{ day.formSubmits }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Top Pages</h3>
    </div>
    <div class="card-body">
      {% if pageViews and pageViews.length > 0 %}
        {% set maxViews = pageViews[0].views %}
        {% for page in pageViews.slice(0, 8) %}
        <div class="chart-bar">
          <div class="label" title="{{ page.url }}">{{ page.url }}</div>
          <div class="bar-container">
            <div class="bar" style="width: {{ (page.views / maxViews * 100) }}%;"></div>
          </div>
          <div class="count">{{ page.views }}</div>
        </div>
        {% endfor %}
      {% else %}
        <div class="empty-state">No data yet</div>
      {% endif %}
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Navigation Actions</h3>
    </div>
    <div class="card-body">
      {% if navigation %}
        {% set totalNav = (navigation.continue or 0) + (navigation.previous or 0) + (navigation.cancel or 0) %}
        {% if totalNav > 0 %}
        <div class="chart-bar">
          <div class="label">Continue</div>
          <div class="bar-container">
            <div class="bar" style="width: {{ ((navigation.continue or 0) / totalNav * 100) }}%; background: var(--color-success);"></div>
          </div>
          <div class="count">{{ navigation.continue or 0 }}</div>
        </div>
        <div class="chart-bar">
          <div class="label">Previous</div>
          <div class="bar-container">
            <div class="bar" style="width: {{ ((navigation.previous or 0) / totalNav * 100) }}%; background: var(--color-warning);"></div>
          </div>
          <div class="count">{{ navigation.previous or 0 }}</div>
        </div>
        <div class="chart-bar">
          <div class="label">Cancel</div>
          <div class="bar-container">
            <div class="bar" style="width: {{ ((navigation.cancel or 0) / totalNav * 100) }}%; background: var(--color-danger);"></div>
          </div>
          <div class="count">{{ navigation.cancel or 0 }}</div>
        </div>
        {% else %}
          <div class="empty-state">No data yet</div>
        {% endif %}
      {% else %}
        <div class="empty-state">No data yet</div>
      {% endif %}
    </div>
  </div>
</div>

{% else %}
<div class="card">
  <div class="card-body">
    <div class="empty-state">
      No analytics data available yet. Start using the prototype to generate data.
    </div>
  </div>
</div>
{% endif %}
{% endblock %}
