{% extends "layouts/analytics.njk" %}

{% set activePage = 'pages' %}

{% block content %}
<div class="page-header">
  <h1 class="page-title">Pages</h1>
  <p class="page-subtitle">Page view statistics and drop-off analysis</p>
</div>

<div class="time-filter">
  <a href="?days=1" {% if days == 1 %}class="active"{% endif %}>Today</a>
  <a href="?days=7" {% if days == 7 %}class="active"{% endif %}>Last 7 days</a>
  <a href="?days=30" {% if days == 30 %}class="active"{% endif %}>Last 30 days</a>
  <a href="?days=90" {% if days == 90 %}class="active"{% endif %}>Last 90 days</a>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-title">All Pages</h3>
  </div>
  <div class="card-body">
    {% if pageViews and pageViews.length > 0 %}
      {% set maxViews = pageViews[0].views %}
      {% for page in pageViews %}
      <div class="chart-bar">
        <div class="label" title="{{ page.url }}">{{ page.url }}</div>
        <div class="bar-container">
          <div class="bar" style="width: {{ (page.views / maxViews * 100) }}%;"></div>
        </div>
        <div class="count">{{ page.views }}</div>
      </div>
      {% endfor %}
    {% else %}
      <div class="empty-state">No page view data yet</div>
    {% endif %}
  </div>
</div>

{% if dropOffs and dropOffs.length > 0 %}
<div class="card">
  <div class="card-header">
    <h3 class="card-title">Drop-off Analysis</h3>
  </div>
  <div class="card-body">
    <p style="color: var(--color-gray-500); font-size: 13px; margin-bottom: 16px;">
      Pages where users stopped without completing the journey
    </p>
    <table class="table">
      <thead>
        <tr>
          <th>Page</th>
          <th style="text-align: right;">Drop-offs</th>
          <th style="text-align: right;">Rate</th>
          <th style="width: 100px;">Severity</th>
        </tr>
      </thead>
      <tbody>
        {% for drop in dropOffs %}
        <tr>
          <td><a href="{{ drop.url }}">{{ drop.url }}</a></td>
          <td style="text-align: right;">{{ drop.count }}</td>
          <td style="text-align: right;">{{ drop.rate }}%</td>
          <td>
            {% if drop.rate >= 30 %}
              <span class="badge severity-high">High</span>
            {% elif drop.rate >= 15 %}
              <span class="badge severity-medium">Medium</span>
            {% else %}
              <span class="badge severity-low">Low</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}
{% endblock %}
