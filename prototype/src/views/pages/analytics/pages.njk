{% extends "layouts/main.njk" %}

{% block pageTitle %}Pages - {{ serviceName }}{% endblock %}

{% block head %}
{{ super() }}
<style>
  .analytics-layout {
    display: flex;
    min-height: calc(100vh - 200px);
    margin: -30px -15px;
    font-family: "GDS Transport", arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  .analytics-sidebar {
    width: 220px;
    background: #f3f2f1;
    border-right: 1px solid #b1b4b6;
    padding: 20px 0;
    flex-shrink: 0;
  }
  .analytics-sidebar a {
    display: block;
    padding: 10px 20px;
    color: #0b0c0c;
    text-decoration: none;
    font-size: 16px;
    border-left: 4px solid transparent;
  }
  .analytics-sidebar a:hover {
    background: #e8e8e8;
  }
  .analytics-sidebar a.active {
    background: #fff;
    border-left-color: #1d70b8;
    font-weight: bold;
  }
  .analytics-sidebar .nav-section {
    padding: 15px 20px 5px;
    font-size: 12px;
    text-transform: uppercase;
    color: #505a5f;
    font-weight: bold;
  }
  .analytics-content {
    flex: 1;
    padding: 30px;
    background: #fff;
  }
  .time-filter {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
  }
  .time-filter a {
    padding: 8px 16px;
    border: 1px solid #b1b4b6;
    border-radius: 4px;
    text-decoration: none;
    color: #0b0c0c;
    font-size: 14px;
  }
  .time-filter a.active {
    background: #1d70b8;
    color: #fff;
    border-color: #1d70b8;
  }
  .time-filter a:hover:not(.active) {
    background: #f3f2f1;
  }
  .chart-container {
    background: #fff;
    border: 1px solid #b1b4b6;
    border-radius: 4px;
    padding: 20px;
    margin-bottom: 20px;
  }
  .chart-container h3 {
    margin-top: 0;
    margin-bottom: 15px;
    font-size: 18px;
  }
  .chart-bar {
    display: flex;
    align-items: center;
    margin-bottom: 8px;
  }
  .chart-bar .label {
    width: 300px;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .chart-bar .bar-container {
    flex: 1;
    height: 24px;
    background: #f3f2f1;
    margin: 0 10px;
    border-radius: 2px;
  }
  .chart-bar .bar {
    height: 100%;
    background: #1d70b8;
    border-radius: 2px;
    min-width: 2px;
  }
  .chart-bar .count {
    width: 60px;
    text-align: right;
    font-size: 14px;
    font-weight: bold;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
  }
  .data-table th, .data-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #b1b4b6;
  }
  .data-table th {
    font-weight: bold;
    background: #f3f2f1;
  }
  .data-table tr:hover {
    background: #f8f8f8;
  }
  .dropoff-indicator {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 3px;
    font-size: 12px;
    font-weight: bold;
  }
  .dropoff-high { background: #f6d7d2; color: #d4351c; }
  .dropoff-medium { background: #fcd6c3; color: #b55505; }
  .dropoff-low { background: #cce2d8; color: #00703c; }
</style>
{% endblock %}

{% block content %}
<div class="analytics-layout">
  <nav class="analytics-sidebar">
    <div class="nav-section">Reports</div>
    <a href="{{ basePath }}">Overview</a>
    <a href="{{ basePath }}/realtime">Real-time</a>
    <div class="nav-section">Engagement</div>
    <a href="{{ basePath }}/pages" class="active">Pages</a>
    <a href="{{ basePath }}/behaviour">Behaviour</a>
    <div class="nav-section">Tools</div>
    <a href="/__prototype-annotator/dashboard">Annotations</a>
    <a href="/case-list">← Back to prototype</a>
  </nav>

  <main class="analytics-content">
    <h1 class="govuk-heading-xl" style="margin-bottom: 10px;">Pages</h1>
    <p class="govuk-body" style="color: #505a5f; margin-bottom: 20px;">Page view statistics and drop-off analysis</p>

    <div class="time-filter">
      <a href="?days=1" {% if days == 1 %}class="active"{% endif %}>Today</a>
      <a href="?days=7" {% if days == 7 %}class="active"{% endif %}>Last 7 days</a>
      <a href="?days=30" {% if days == 30 %}class="active"{% endif %}>Last 30 days</a>
      <a href="?days=90" {% if days == 90 %}class="active"{% endif %}>Last 90 days</a>
    </div>

    <div class="chart-container">
      <h3>All Pages</h3>
      {% if pageViews and pageViews.length > 0 %}
        {% set maxViews = pageViews[0].views %}
        {% for page in pageViews %}
        <div class="chart-bar">
          <div class="label" title="{{ page.url }}">{{ page.url }}</div>
          <div class="bar-container">
            <div class="bar" style="width: {{ (page.views / maxViews * 100) }}%;"></div>
          </div>
          <div class="count">{{ page.views }}</div>
        </div>
        {% endfor %}
      {% else %}
        <p class="govuk-body">No page view data yet</p>
      {% endif %}
    </div>

    {% if dropOffs and dropOffs.length > 0 %}
    <div class="chart-container">
      <h3>Drop-off Analysis</h3>
      <p class="govuk-body" style="color: #505a5f; margin-bottom: 15px;">
        Pages where users stopped without completing the journey
      </p>
      <table class="data-table">
        <thead>
          <tr>
            <th>Page</th>
            <th style="text-align: right;">Drop-offs</th>
            <th style="text-align: right;">Rate</th>
            <th style="width: 100px;">Severity</th>
          </tr>
        </thead>
        <tbody>
          {% for drop in dropOffs %}
          <tr>
            <td><a href="{{ drop.url }}" class="govuk-link">{{ drop.url }}</a></td>
            <td style="text-align: right;">{{ drop.count }}</td>
            <td style="text-align: right;">{{ drop.rate }}%</td>
            <td>
              {% if drop.rate >= 30 %}
                <span class="dropoff-indicator dropoff-high">High</span>
              {% elif drop.rate >= 15 %}
                <span class="dropoff-indicator dropoff-medium">Medium</span>
              {% else %}
                <span class="dropoff-indicator dropoff-low">Low</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </main>
</div>
{% endblock %}
