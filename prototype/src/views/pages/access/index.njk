{% extends "layouts/main.njk" %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errors and errors.length > 0 %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: errors
      }) }}
    {% endif %}

    <h1 class="govuk-heading-l">Enter access code</h1>

    <p class="govuk-body">This is a prototype service. You need an access code to continue.</p>

    <form method="post" action="/access">

      {{ govukInput({
        label: {
          text: "Access code",
          classes: "govuk-label--m"
        },
        id: "accessCode",
        name: "accessCode",
        type: "text",
        autocomplete: "off",
        classes: "govuk-input--width-10",
        value: values.accessCode,
        errorMessage: { text: errors[0].message } if errors and errors.length > 0 and errors[0].field === 'accessCode'
      }) }}

      {{ govukButton({
        text: "Continue"
      }) }}

    </form>

  </div>
</div>
{% endblock %}
