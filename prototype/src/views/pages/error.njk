{% extends "layouts/main.njk" %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">{{ heading }}</h1>
    <p class="govuk-body">{{ message }}</p>
    {% if session.user %}
    <p class="govuk-body">
      <a href="/possessions" class="govuk-link">Go to service home</a>
    </p>
    {% else %}
    <p class="govuk-body">
      <a href="/access" class="govuk-link">Go to start page</a>
    </p>
    {% endif %}
  </div>
</div>
{% endblock %}
