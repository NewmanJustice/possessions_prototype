{% extends "govuk/template.njk" %}

{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/footer/macro.njk" import govukFooter %}

{% block pageTitle -%}
{% if errors and errors.length > 0 %}Error: {% endif %}{{ pageTitle | default("HMCTS Possessions") }} - {{ serviceName }} - GOV.UK
{%- endblock %}

{% block head %}
  <link href="/govuk/govuk-frontend.min.css" rel="stylesheet">
  <link href="/public/css/custom.css" rel="stylesheet">
  {% if errors and errors.length > 0 %}
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      var errorSummary = document.querySelector('.govuk-error-summary');
      if (errorSummary) {
        errorSummary.focus();
      }
    });
  </script>
  {% endif %}
{% endblock %}

{% block header %}
  {{ govukHeader({
    homepageUrl: "/case-list",
    serviceName: serviceName,
    serviceUrl: "/case-list",
    navigation: [
      {
        href: "/case-list",
        text: "Case list",
        active: true if pageTitle == "Case list"
      } if session.user,
      {
        href: "/claims/start",
        text: "Create case",
        active: true if 'claim' in (pageTitle | lower) or 'property' in (pageTitle | lower) or 'claimant' in (pageTitle | lower) or 'defendant' in (pageTitle | lower) or 'ground' in (pageTitle | lower) or 'possession' in (pageTitle | lower)
      } if session.user,
      {
        href: "/sign-out",
        text: "Sign out",
        active: false
      } if session.user
    ]
  }) }}
{% endblock %}

{% block beforeContent %}
  {# Prominent prototype banner with language switcher #}
  <div class="govuk-phase-banner">
    <p class="govuk-phase-banner__content" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: nowrap;">
      <span style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0;">
        <strong class="govuk-tag govuk-tag--red" style="flex-shrink: 0;">PROTOTYPE</strong>
        <span class="govuk-phase-banner__text" style="flex: 1;">
          This is a prototype. Do not enter real personal information. All data is fake.
        </span>
      </span>
      <span class="govuk-phase-banner__text" style="white-space: nowrap; flex-shrink: 0; margin-left: 20px;">
        {% set currentLanguage = session.language | default('en') %}
        {% if currentLanguage == 'en' %}
          <span style="color: #505a5f;">English</span> | <a href="?lang=cy" class="govuk-link">Cymraeg</a>
        {% else %}
          <a href="?lang=en" class="govuk-link">English</a> | <span style="color: #505a5f;">Cymraeg</span>
        {% endif %}
      </span>
    </p>
  </div>

  {% if showBackLink %}
    {{ govukBackLink({
      text: "Back",
      href: backLinkHref | default("javascript:history.back()")
    }) }}
  {% endif %}
{% endblock %}

{% block content %}
  {# Content will be injected by child templates #}
{% endblock %}

{% block footer %}
  {{ govukFooter({
    meta: {
      items: [
        {
          href: "/health",
          text: "Health check"
        }
      ],
      html: 'Built using the <a class="govuk-footer__link" href="https://design-system.service.gov.uk/">GOV.UK Design System</a>'
    }
  }) }}
{% endblock %}

{% block bodyEnd %}
  <script src="/govuk/all.bundle.js"></script>
  <script>
    window.GOVUKFrontend.initAll();
  </script>
{% endblock %}
